# Copie este arquivo para ".env" e ajuste os valores.

# Porta HTTP da API
PORT=3333

# Segredo usado para assinar os tokens JWT e os tokens do QR Code.
# Em produção, use um valor longo e aleatório.
JWT_SECRET=troque-este-segredo

# Validade do login
JWT_EXPIRA_EM=8h

# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGENS=http://localhost:5173

# Regras da chamada
QR_VALIDADE_SEGUNDOS=30
RAIO_PERMITIDO_METROS=20

# Conexão com o PostgreSQL. Com ela definida, a API usa o banco; crie-o antes
# com "npm run db:setup". Sem ela, os dados ficam em memória (ARQUIVO_DADOS).
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/presenca

# Banco usado por "npm test". ATENÇÃO: ele é apagado e recriado a cada execução,
# então precisa ser diferente de DATABASE_URL. Sem ela, os testes usam a memória.
# TEST_DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/presenca_teste

# Arquivo onde o repositório em memória salva os dados entre reinícios
# (só usado sem DATABASE_URL). Deixe vazio para não persistir nada em disco.
ARQUIVO_DADOS=data/db.json
